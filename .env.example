# AutoBatch 环境变量配置模板
# 复制为 .env 并填入实际值，不要提交真实凭证到版本控制
#
# MinIO / S3 存储
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# Spark 集群（本地开发默认值）
SPARK_HOME=C:/spark_home
JAVA_HOME=C:/jdk17
HADOOP_HOME=C:/hadoop
PYSPARK_PYTHON=python3
PYSPARK_DRIVER_PYTHON=C:/Python314/python.exe

# Iceberg Catalog（开发用 SQLite，生产改用 REST）
ICEBERG_CATALOG_TYPE=sql
ICEBERG_CATALOG_URI=sqlite:///state/iceberg_catalog.db

# 监控端口
MONITORING_PORT=8086
