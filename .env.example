# AutoBatch 环境变量配置模板
# 复制为 .env 并填入实际值，不要提交真实凭证到版本控制（.gitignore 已忽略 .env / .env.*）
#
# 注意：本仓库【没有 dotenv 加载器】（代码不读取 .env 文件）。以下变量需手动
# export / Set-Item Env: 注入进程环境，或经 docker-compose / CI 的 env 段注入。
#
# ─────────────────────────────────────────────────────────────
# S3 / MinIO 凭证（代码实际读取，见 src/io/_s3_parquet.py s3_credentials）
# 解析优先级：config 显式 storage.access_key/secret_key > 环境变量。
# 环境变量先尝试 MINIO_ROOT_USER / MINIO_ROOT_PASSWORD（本地 MinIO 惯例，
# 与 .github/workflows/ci.yml MinIO service、docker/iceberg/docker-compose.yml
# 注入的变量名一致），再尝试 AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# （AWS 通用惯例）。config/pipeline.json 与 pipeline_small.json 缺省省略
# access_key/secret_key（见其中 _s3_creds_note），推荐经环境变量注入凭证。
# ─────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# AWS 风格变量名（与上面二选一即可；两组都设置时 MINIO_* 优先）
#AWS_ACCESS_KEY_ID=minioadmin
#AWS_SECRET_ACCESS_KEY=minioadmin

# ─────────────────────────────────────────────────────────────
# Spark 本地模式环境（代码实际读取，见 src/helpers.py spark 环境探测逻辑：
# SPARK_HOME / JAVA_HOME / HADOOP_HOME / PYSPARK_PYTHON / PYSPARK_DRIVER_PYTHON；
# 未设置时代码会自动探测常见安装路径并 setdefault 回填）
# ─────────────────────────────────────────────────────────────
SPARK_HOME=C:/spark_home
JAVA_HOME=C:/jdk17
HADOOP_HOME=C:/hadoop
PYSPARK_PYTHON=python3
PYSPARK_DRIVER_PYTHON=C:/Python314/python.exe

# ─────────────────────────────────────────────────────────────
# 下列变量当前版本【无任何代码读取】，仅保留说明（任务80 自原模板移除）：
#   - MINIO_ENDPOINT / MINIO_SECURE   → 对应配置项为 config 的
#     storage.endpoint / storage.secure（src/io/_s3_parquet.py 从 config 读取）
#   - ICEBERG_CATALOG_TYPE / ICEBERG_CATALOG_URI → 对应配置项为 config 的
#     storage.iceberg.catalog_type / storage.iceberg.catalog_uri
#   - MONITORING_PORT                 → 监控 HealthServer 端口由 config 的
#     monitoring 段控制，无环境变量入口
# docker/spark-cluster/docker-compose.yml 也不引用上述变量（其 build args
# 仅透传 SPARK_VERSION / ENABLE_ICEBERG，见该文件注释）。
# ─────────────────────────────────────────────────────────────
